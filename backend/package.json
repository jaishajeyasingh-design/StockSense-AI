{
  "name": "stocksense-backend",
  "version": "1.0.0",
  "description": "StockSense AI Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "test": "node --test tests/**/*.test.js",
